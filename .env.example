# .env — конфигурация для production. Скопируй: cp .env.example .env
# Обязательно поменяй SECRET_KEY на случайный!

# Секретный ключ Flask (сессии, flash-сообщения). Сгенерируй случайный!
# Команда: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_HEX_STRING

# Режим отладки (0 = production, 1 = debug — НЕ использовать на проде!)
FLASK_DEBUG=0

# Кол-во воркеров Gunicorn (обычно = кол-ву ядер CPU, 2-4)
GUNICORN_WORKERS=4

# Порт Nginx (80 = HTTP, 443 = HTTPS)
NGINX_PORT=80
