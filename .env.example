# .env — конфигурация для production. Скопируйте: cp .env.example .env

# Секретный ключ Flask (сессии)
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_HEX

# Режим отладки (0 = production)
FLASK_DEBUG=0

# Воркеры Gunicorn (обычно = кол-ву ядер CPU)
GUNICORN_WORKERS=4

# Домен для HTTPS (пустой = HTTP только)
DOMAIN=

# Basic Auth (логин:пароль для доступа)
AUTH_USER=beerpedia
AUTH_PASS=CHANGE_ME
